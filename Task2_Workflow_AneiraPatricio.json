      "credentials": {
        "discordWebhookApi": {
          "id": "i5aEZEUSuS2Rq925",
          "name": "Discord Webhook account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst e = j.error || {};\nconst reason = e.message || j.message || JSON.stringify(j).slice(0, 300);\nreturn [{ json: { message: `⚠️ **Morning Brief failed**\\nReason: ${reason}\\nExecution: ${$execution.id}\\nTime: ${new Date().toISOString()}` } }];"
      },
