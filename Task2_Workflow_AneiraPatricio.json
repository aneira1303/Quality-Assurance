        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "c9ae7005-b438-4d40-a891-1c5560eba3b1",
      "name": "Tag Hot",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1328,
        0
