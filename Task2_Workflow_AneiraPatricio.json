            }
          ]
        }
      },
      "id": "1eaacf8f-a574-47d1-8141-1638986dcc1d",
      "name": "Every 1 Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/repositories",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=topic:llm created:>{{ $now.minus({days:30}).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "f59a83d0-597e-4ea6-bd50-7067367d3f40",
      "name": "GitHub Search Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        192
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "githubApi": {
          "id": "ftuX7es9y2ua7VA4",
          "name": "GitHub account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst repos = (resp.items || []).filter(r => !r.archived && !r.fork);\nif (!repos.length) throw new Error('GitHub search returned no usable repositories');\nreturn repos\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5)\n  .map(r => ({ json: {\n    full_name: r.full_name,\n    description: r.description || 'No description',\n    stars: r.stargazers_count,\n    language: r.language || 'n/a',\n    url: r.html_url\n  }}));"
      },
      "id": "4347f150-e8d7-412e-97aa-68cfbd6ca5b6",
      "name": "Reshape Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.full_name }}/readme",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "readme"
            }
          },
          "timeout": 15000
        }
      },
      "id": "aa4cb3e5-da6f-410a-87a7-33a073731bdb",
      "name": "Fetch README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "githubApi": {
          "id": "ftuX7es9y2ua7VA4",
          "name": "GitHub account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const repo = $('Reshape Top 5').all()[$itemIndex].json;\nconst ok = typeof $json.readme === 'string' && !$json.error;\nconst snippet = ok ? $json.readme.replace(/\\s+/g, ' ').trim().slice(0, 200) : 'README unavailable';\nreturn { json: { ...repo, readme_snippet: snippet, readme_ok: ok } };"
      },
      "id": "f0be95f6-86fc-4b04-be6c-ef9c6c5806a6",
      "name": "Attach README Snippet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.stars }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "93613efb-6fe6-442d-b2cf-3e7e0c21e715",
      "name": "Stars > 1000?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1104,
        80
      ]
    },
