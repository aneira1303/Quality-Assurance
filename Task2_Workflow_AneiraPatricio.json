              "name": "tier",
              "value": "rising",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "188908a5-e329-4f3f-b2cb-60de1f194dfe",
      "name": "Tag Rising",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1328,
        160
      ]
    },
    {
      "parameters": {},
      "id": "70e5936a-fcd7-4ff6-8d99-699f4f255f93",
      "name": "Merge Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1552,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json).sort((a, b) => b.stars - a.stars);\nconst line = r => `• **${r.full_name}** ⭐ ${r.stars} (${r.language})\\n  ${r.description}\\n  ${r.url}\\n  _README: ${r.readme_snippet}_`;\nconst hot = items.filter(r => r.tier === 'hot');\nconst rising = items.filter(r => r.tier === 'rising');\nlet msg = `🌅 **Morning Brief: top LLM repos (last 30 days)** ${new Date().toISOString().slice(0, 10)}`;\nif (hot.length) msg += `\\n\\n🔥 **Hot (more than 1000 stars)**\\n` + hot.map(line).join('\\n');\nif (rising.length) msg += `\\n\\n🌱 **Rising**\\n` + rising.map(line).join('\\n');\nreturn [{ json: { message: msg.slice(0, 1900) } }];"
      },
      "id": "c310ed15-1d15-4eca-90f8-7c49671b1df5",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        80
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
